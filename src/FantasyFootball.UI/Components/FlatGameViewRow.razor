@using FantasyFootball.Models
@using FantasyFootball.Services
@inject IDataService DataService

@* Flat-model game-row. Mirrors the DOM structure of GameViewRow so the
   existing scoreboard-* CSS classes apply identically. *@

<div class="scoreboard-row-wrapper" id="@(ShowSim ? "current-game" : null)">
<div class="scoreboard-row @(IsJustFinished ? "scoreboard-row-just-finished" : "")">
  <div class="scoreboard-group-tag">
    <span class="scoreboard-group-tag-letter">@_groupLetter</span>
    <span class="scoreboard-group-tag-time">@Game.PlayedOn.ToString("HH:mm")</span>
  </div>
  <div class="scoreboard-team scoreboard-team-home @TeamClass(HomeIsWinner)">
    <span class="scoreboard-team-name">@_homeLabel</span>
    @if (_homeTeam is not null) { <FlagIcon Team="_homeTeam" Size="24" /> }
  </div>
  <div class="scoreboard-score @(HasResult ? "" : "scoreboard-pending")">@_resultText</div>
  <div class="scoreboard-team scoreboard-team-away @TeamClass(AwayIsWinner)">
    @if (_awayTeam is not null) { <FlagIcon Team="_awayTeam" Size="24" /> }
    <span class="scoreboard-team-name">@_awayLabel</span>
  </div>
  <div class="scoreboard-action" @onclick:stopPropagation="true">
    @if (ShowSim)
    {
      <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                     Color="Color.Primary"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnSim"
                     title="Simulate this game (Space)" />
    }
    else if (ShowUndo)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Replay"
                     Color="Color.Primary"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnRedo"
                     title="Re-simulate this game (Ctrl+Y)" />
      <MudIconButton Icon="@Icons.Material.Filled.Undo"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnUndo"
                     title="Undo this game (Ctrl+Z or U)" />
    }
  </div>
</div>
</div>

@code {
  [Parameter] public FlatGame Game { get; set; } = null!;
  [Parameter] public FlatCompetition Competition { get; set; } = null!;
  [Parameter] public bool ShowSim { get; set; }
  [Parameter] public bool ShowUndo { get; set; }
  [Parameter] public bool IsJustFinished { get; set; }
  [Parameter] public bool Disabled { get; set; }
  [Parameter] public EventCallback OnSim { get; set; }
  [Parameter] public EventCallback OnUndo { get; set; }
  [Parameter] public EventCallback OnRedo { get; set; }

  Team? _homeTeam;
  Team? _awayTeam;
  string _homeLabel = "";
  string _awayLabel = "";
  string _groupLetter = "";
  string _resultText = "";

  protected override void OnParametersSet()
  {
    var homeId = FlatCompetitionExtensions.HomeTeamIdOf(Game);
    var awayId = FlatCompetitionExtensions.AwayTeamIdOf(Game);
    _homeTeam = homeId is null ? null : DataService.AllTeams.FirstOrDefault(t => t.ShortName == homeId);
    _awayTeam = awayId is null ? null : DataService.AllTeams.FirstOrDefault(t => t.ShortName == awayId);

    // Resolved team → its Name; unresolved KO slot → human-readable qualifier
    // ("Winner of Round of 16 game 1" instead of "W-49"); group game with an
    // unknown team-id (placeholder) → fall back to the id itself.
    _homeLabel = _homeTeam?.Name ?? LabelForUnresolved(Game, isHome: true) ?? homeId ?? "?";
    _awayLabel = _awayTeam?.Name ?? LabelForUnresolved(Game, isHome: false) ?? awayId ?? "?";

    _groupLetter = Game switch
    {
      FlatGroupGame gg => gg.GroupLetter,
      // For KO games, show the short round code + position-in-round
      // (e.g. "R16 1", "QF 2"). Single-game rounds (3rd, F) drop the number.
      FlatKoGame => Competition is null
        ? FlatRoundShortNames.Of(Game.RoundId)
        : Competition.Games.Count(g => g.RoundId == Game.RoundId) == 1
          ? FlatRoundShortNames.Of(Game.RoundId)
          : $"{FlatRoundShortNames.Of(Game.RoundId)} {Competition.PositionInRound(Game)}",
      _ => "",
    };
    _resultText = Game.Result is { } r ? r.Format() : "v";
  }

  string? LabelForUnresolved(FlatGame g, bool isHome) => g is FlatKoGame ko
    ? FlatQualifierDescriber.Describe(Competition, isHome ? ko.HomeQual : ko.AwayQual)
    : null;

  bool HasResult => Game.Result is not null;
  bool IsDraw => Game.Result is { } r && r.HomeScore == r.AwayScore;
  bool HomeIsWinner => Game.Result is { } r && r.HomeScore > r.AwayScore;
  bool AwayIsWinner => Game.Result is { } r && r.AwayScore > r.HomeScore;

  string TeamClass(bool isWinner) => HasResult
    ? (isWinner ? "scoreboard-team-winner" : IsDraw ? "" : "scoreboard-team-loser")
    : "";
}
