<MudDialog>
  <DialogContent>
    <MudStack Spacing="3">
      <MudText Typo="Typo.body2" Color="Color.Secondary">
        Name this set so you can pick it back up later (e.g. <em>Germany-OP</em>).
      </MudText>
      <MudTextField @bind-Value="_name"
                    Label="Name"
                    Variant="Variant.Outlined"
                    Immediate="true"
                    OnKeyUp="OnKeyUp"
                    HelperText="@HelperText" />
    </MudStack>
  </DialogContent>
  <DialogActions>
    <MudButton OnClick="Cancel">Cancel</MudButton>
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               OnClick="Save"
               Disabled="@(!IsValid)">
      Save
    </MudButton>
  </DialogActions>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

  /// <summary>Names already in use — input is rejected if it collides.</summary>
  [Parameter] public IReadOnlyCollection<string> ExistingNames { get; set; } = [];

  string _name = "";

  bool IsValid => !string.IsNullOrWhiteSpace(_name) && !ExistingNames.Contains(_name.Trim(), StringComparer.OrdinalIgnoreCase);

  string HelperText => string.IsNullOrWhiteSpace(_name)
    ? "Required."
    : ExistingNames.Contains(_name.Trim(), StringComparer.OrdinalIgnoreCase)
      ? "Already in use — pick a different name."
      : $"Will save as \"{_name.Trim()}\".";

  void Cancel() => MudDialog.Cancel();

  void OnKeyUp(KeyboardEventArgs e)
  {
    if (e.Key == "Enter" && IsValid) { Save(); }
  }

  void Save() => MudDialog.Close(DialogResult.Ok(_name.Trim()));
}
