@using FantasyFootball.Data
@using FantasyFootball.Services
@inject ISettingsService Settings

@if (FallbackIcon is { Length: > 0 } icon)
{
  @if (Settings.UseOfficialCompetitionLogos && OfficialPath is { } src)
  {
    @* Both layers render. img sits on top via CSS; if its src 404s, onerror hides it and the MudIcon underneath shows through — no broken-image placeholder. *@
    <span class="comp-type-icon-stack" style="@StackStyle">
      <MudIcon Icon="@icon" Style="@($"font-size: {Size}px;")" Color="Color.Inherit" Title="@AltText" />
      <img src="@src" alt="@AltText" class="comp-type-icon-overlay" onerror="this.style.display='none';" onload="this.style.display='';" />
    </span>
  }
  else
  {
    <MudIcon Icon="@icon" Style="@($"font-size: {Size}px;")" Color="Color.Inherit" Title="@AltText" />
  }
}

@code {
  [Parameter] public CompetitionType Type { get; set; }
  [Parameter] public int Size { get; set; } = 24;

  // Material Icons used when the "official logos" flag is off OR the official file 404s. Default arm so an unhandled enum value still renders something.
  string? FallbackIcon => Type switch
  {
    CompetitionType.WM => Icons.Material.Filled.EmojiEvents,
    CompetitionType.EM => Icons.Material.Filled.Stars,
    CompetitionType.CHAMPIONS_LEAGUE => Icons.Material.Filled.WorkspacePremium,
    _ => Icons.Material.Filled.SportsSoccer,
  };

  // Bundled SVGs ship in the UI Razor class library; consumed via the RCL `_content/{lib}/...` prefix. See tools/fetch-logos.sh + tools/fetch-flogos.sh for the refresh pipelines.
  string? OfficialPath => Type switch
  {
    CompetitionType.WM => Svg("wm"),
    CompetitionType.EM => Svg("em"),
    CompetitionType.CHAMPIONS_LEAGUE => Svg("ucl"),
    CompetitionType.BUNDESLIGA => Svg("bundesliga"),
    CompetitionType.PREMIER_LEAGUE => Svg("pl"),
    CompetitionType.SERIE_A => Svg("seriea"),
    CompetitionType.LA_LIGA => Svg("laliga"),
    CompetitionType.LIGUE_1 => Svg("ligue1"),
    _ => null,
  };

  static string Svg(string name) => $"_content/FantasyFootball.UI/img/competitions/{name}.svg";

  string AltText => Type switch
  {
    CompetitionType.WM => "FIFA World Cup",
    CompetitionType.EM => "UEFA European Championship",
    CompetitionType.CHAMPIONS_LEAGUE => "UEFA Champions League",
    CompetitionType.BUNDESLIGA => "Bundesliga",
    CompetitionType.PREMIER_LEAGUE => "Premier League",
    CompetitionType.SERIE_A => "Serie A",
    CompetitionType.LA_LIGA => "LaLiga",
    CompetitionType.LIGUE_1 => "Ligue 1",
    _ => Type.ToString(),
  };

  string StackStyle => $"width: {Size}px; height: {Size}px;";
}
