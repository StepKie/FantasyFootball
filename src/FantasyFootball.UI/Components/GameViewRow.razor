@using FantasyFootball.Data
@using FantasyFootball.Models
@using FantasyFootball.Repositories
@using FantasyFootball.Services
@inject IDataService DataService
@inject ICompetitionRepository Repo
@inject IVenueRegistry VenueRegistry

<div class="scoreboard-row-wrapper" id="@(ShowSim ? "current-game" : ShowUndo ? "just-finished-game" : null)">
<div class="scoreboard-row @(IsJustFinished ? "scoreboard-row-just-finished" : "") @(DetailsOpen ? "scoreboard-row-open" : "")"
     @onclick="HandleRowClick"
     style="cursor: pointer;">
  <div class="scoreboard-group-tag">
    <span class="scoreboard-group-tag-letter">@_groupLetter</span>
    <span class="scoreboard-group-tag-time">@Game.PlayedOn.ToString("HH:mm")</span>
  </div>
  <div class="scoreboard-team scoreboard-team-home @TeamClass(HomeIsWinner)">
    <span class="scoreboard-team-name">@_homeLabel</span>
    @if (_homeTeam is not null) { <FlagIcon Team="_homeTeam" Size="24" /> }
  </div>
  <div class="scoreboard-score @(HasResult ? "" : "scoreboard-pending")">
    @if (Game.Result is { } r)
    {
      <div>@r.HomeScore-@r.AwayScore</div>
      @if (r.Ending == GameEnd.EXTRA_TIME)
      {
        <div class="scoreboard-score-ext">e.t.</div>
      }
      else if (r.Ending == GameEnd.PENALTIES)
      {
        <div class="scoreboard-score-ext">@r.PenaltyHome-@r.PenaltyAway pen.</div>
      }
    }
    else
    {
      <span>v</span>
    }
  </div>
  <div class="scoreboard-team scoreboard-team-away @TeamClass(AwayIsWinner)">
    @if (_awayTeam is not null) { <FlagIcon Team="_awayTeam" Size="24" /> }
    <span class="scoreboard-team-name">@_awayLabel</span>
  </div>
  <div class="scoreboard-action" @onclick:stopPropagation="true">
    @if (ShowSim)
    {
      <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                     Color="Color.Primary"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnSim"
                     title="Simulate this game (Space)" />
    }
    else if (ShowUndo)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Replay"
                     Color="Color.Primary"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnRedo"
                     title="Re-simulate this game (Ctrl+Y)" />
      <MudIconButton Icon="@Icons.Material.Filled.Undo"
                     Size="Size.Small"
                     Disabled="Disabled"
                     OnClick="OnUndo"
                     title="Undo this game (Ctrl+Z or U)" />
    }
  </div>
</div>
<MudPopover Open="DetailsOpen"
            AnchorOrigin="Origin.BottomCenter"
            TransformOrigin="Origin.TopCenter"
            Paper="true"
            Class="game-details-popover">
  @if (DetailsOpen)
  {
    @if (_venue is not null)
    {
      <div class="game-details-row">
        <span class="game-details-label">Venue</span>
        <span class="game-details-value game-details-value-text">@_venue.Name@(_venue.City is { } c ? $" · {c}" : "") · cap. @_venue.Capacity.ToString("N0")</span>
      </div>
    }
    @if (Game.Attendance is { } att)
    {
      <div class="game-details-row">
        <span class="game-details-label">Attendance</span>
        <span class="game-details-value">@att.ToString("N0")</span>
      </div>
    }
    @if (_homeTeam is null || _awayTeam is null)
    {
      <MudText Typo="Typo.body2">Teams not yet decided.</MudText>
    }
    else
    {
      <div class="game-details-row">
        <span class="game-details-label">Elo</span>
        <span class="game-details-value game-details-value-pair">
          <span>@_homeTeam.Elo</span>
          <span class="game-details-sep">—</span>
          <span>@_awayTeam.Elo</span>
        </span>
      </div>
      <div class="game-details-row">
        <span class="game-details-label">Expected goals</span>
        <span class="game-details-value game-details-value-pair">
          <span>@_prob.XgHome.ToString("0.0")</span>
          <span class="game-details-sep">—</span>
          <span>@_prob.XgAway.ToString("0.0")</span>
        </span>
      </div>
      <div class="game-details-row">
        <span class="game-details-label">Win / Draw / Loss</span>
        <span class="game-details-value">
          <span class="@PctClass(HomeIsWinner)">@FormatPct(_prob.Home)</span>
          <span class="game-details-sep">/</span>
          <span class="@PctClass(IsDraw)">@FormatPct(_prob.Draw)</span>
          <span class="game-details-sep">/</span>
          <span class="@PctClass(AwayIsWinner)">@FormatPct(_prob.Away)</span>
        </span>
      </div>
      <div class="game-details-row">
        <span class="game-details-label">H2H (all sims)</span>
        <span class="game-details-value">
          @if (_h2h.Total == 0) { <em>none</em> }
          else { @($"{_h2h.TeamAWins}–{_h2h.Draws}–{_h2h.TeamBWins}") }
        </span>
      </div>
      <MudDivider Class="my-2" />
      <div class="game-details-links">
        <MudLink Href="@($"teams/{_homeTeam.Id}?from=competitions/{Competition?.Id}")" Typo="Typo.body2">@_homeTeam.Name</MudLink>
        <MudLink Href="@($"teams/{_awayTeam.Id}?from=competitions/{Competition?.Id}")" Typo="Typo.body2">@_awayTeam.Name</MudLink>
      </div>
    }
  }
</MudPopover>
</div>

@code {
  [Parameter] public Game Game { get; set; } = null!;
  [Parameter] public Competition Competition { get; set; } = null!;
  [Parameter] public bool ShowSim { get; set; }
  [Parameter] public bool ShowUndo { get; set; }
  [Parameter] public bool IsJustFinished { get; set; }
  [Parameter] public bool DetailsOpen { get; set; }
  [Parameter] public bool Disabled { get; set; }
  [Parameter] public EventCallback OnSim { get; set; }
  [Parameter] public EventCallback OnUndo { get; set; }
  [Parameter] public EventCallback OnRedo { get; set; }
  [Parameter] public EventCallback OnDetailsToggle { get; set; }

  Team? _homeTeam;
  Team? _awayTeam;
  Venue? _venue;
  string _homeLabel = "";
  string _awayLabel = "";
  string _groupLetter = "";
  bool _prevDetailsOpen;
  string? _lastFetchedHomeId;
  string? _lastFetchedAwayId;
  MatchProbability.Prediction _prob;
  HeadToHeadLookup.Result _h2h;

  protected override async Task OnParametersSetAsync()
  {
    var homeId = CompetitionExtensions.HomeTeamIdOf(Game);
    var awayId = CompetitionExtensions.AwayTeamIdOf(Game);
    _homeTeam = homeId is null ? null : DataService.AllTeams.FirstOrDefault(t => t.ShortName == homeId);
    _awayTeam = awayId is null ? null : DataService.AllTeams.FirstOrDefault(t => t.ShortName == awayId);
    _venue = Game.VenueId is { } vid ? VenueRegistry.Get(vid) : null;

    // Resolved team → Name; unresolved KO slot → "Winner of R16 #1"; otherwise raw id.
    _homeLabel = _homeTeam?.Name ?? LabelForUnresolved(Game, isHome: true) ?? homeId ?? "?";
    _awayLabel = _awayTeam?.Name ?? LabelForUnresolved(Game, isHome: false) ?? awayId ?? "?";

    _groupLetter = Game switch
    {
      GroupGame gg => gg.GroupLetter,
      // KO: short round code + position; single-game rounds (3rd, F) drop the position.
      KoGame => Competition is null
        ? RoundShortNames.Of(Game.RoundId)
        : Competition.Games.Count(g => g.RoundId == Game.RoundId) == 1
          ? RoundShortNames.Of(Game.RoundId)
          : $"{RoundShortNames.Of(Game.RoundId)} {Competition.PositionInRound(Game)}",
      _ => "",
    };
    // Fetch when the popover is open with resolved teams AND we haven't already fetched for this exact (home, away) pair. Pair tracking guards against Blazor reusing this component for a different game (list reorder after sim) without re-running the fetch.
    var canFetch = DetailsOpen && _homeTeam is not null && _awayTeam is not null;
    var pairChanged = _homeTeam?.ShortName != _lastFetchedHomeId || _awayTeam?.ShortName != _lastFetchedAwayId;
    if (canFetch && (!_prevDetailsOpen || pairChanged))
    {
      _prevDetailsOpen = true;
      var fetchHomeId = _homeTeam!.ShortName;
      var fetchAwayId = _awayTeam!.ShortName;
      _lastFetchedHomeId = fetchHomeId;
      _lastFetchedAwayId = fetchAwayId;
      _prob = MatchProbability.Predict(_homeTeam.Elo, _awayTeam.Elo);
      // Force a real yield so the popover renders W/D/L + xG immediately while the O(N comps) H2H walk runs. Capture team ids into locals above — they're stable across the suspension; _homeTeam / _awayTeam could be reset by a concurrent OnParametersSetAsync.
      await Task.Yield();
      _h2h = await HeadToHeadLookup.AcrossAsync(Repo, fetchHomeId, fetchAwayId);
    }
    else if (!canFetch)
    {
      _prevDetailsOpen = false;
    }
  }

  Task HandleRowClick() => OnDetailsToggle.InvokeAsync();

  // Floor at "<1%": "0%" reads as impossible for a heavy underdog who could still win.
  static string FormatPct(double p) => p > 0 && p < 0.005 ? "<1%" : $"{p * 100:0}%";

  static string PctClass(bool isActualOutcome) => isActualOutcome ? "game-details-pct-actual" : "";

  string? LabelForUnresolved(Game g, bool isHome) => g is KoGame ko
    ? QualifierDescriber.Describe(Competition, isHome ? ko.HomeQual : ko.AwayQual)
    : null;

  bool HasResult => Game.Result is not null;
  bool IsDraw => Game.Result is { } r && r.IsDraw;
  bool HomeIsWinner => Game.Result is { } r && r.HomeWon;
  bool AwayIsWinner => Game.Result is { } r && r.AwayWon;

  string TeamClass(bool isWinner) => HasResult
    ? (isWinner ? "scoreboard-winner" : IsDraw ? "" : "scoreboard-loser")
    : "";
}
