@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
  <MudAppBar Elevation="1">
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                   OnClick="@(() => _drawerOpen = !_drawerOpen)" />
    <MudText Typo="Typo.h6" Class="ml-2">Fantasy Football</MudText>
    <MudSpacer />
    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   Color="Color.Inherit"
                   OnClick="@(() => _isDarkMode = !_isDarkMode)" />
  </MudAppBar>
  <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
    <NavMenu />
  </MudDrawer>
  <MudMainContent>
    <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
      @Body
    </MudContainer>
  </MudMainContent>
</MudLayout>

@code {
  bool _drawerOpen = true;
  bool _isDarkMode;
}
