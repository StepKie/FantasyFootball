@page "/competitions/{Id:int}"
@using FantasyFootball.Models
@using FantasyFootball.Services
@using FantasyFootball.UI.Components
@using FantasyFootball.UI.ViewModels
@using Microsoft.JSInterop
@inject FlatCompetitionDetailViewModel ViewModel
@inject IDataService DataService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(ViewModel.Competition?.Title ?? "Competition") — Fantasy Football</PageTitle>

<MudButton Href="competitions"
           StartIcon="@Icons.Material.Filled.ArrowBack"
           Variant="Variant.Text"
           Class="mb-3">
  Back to competitions
</MudButton>

@if (ViewModel.Competition is null)
{
  <MudAlert Severity="Severity.Warning">Competition not found.</MudAlert>
}
else
{
  <MudStack Spacing="3">

    @* Title + main sim controls *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
      <CompetitionTypeIcon Type="@ViewModel.Competition.Type" Size="36" />
      <MudText Typo="Typo.h5" HtmlTag="h1">
        @ViewModel.Competition.Title <span style="opacity:0.6;">#@ViewModel.Competition.Id</span>
      </MudText>
      @if (!ViewModel.IsFinished)
      {
        <MudIconButton Icon="@Icons.Material.Filled.DoubleArrow"
                       Size="Size.Small"
                       OnClick="ViewModel.SimulateAll"
                       Disabled="ViewModel.IsBusy"
                       title="Simulate tournament (T)" />
        <MudIconButton Icon="@Icons.Material.Filled.MyLocation"
                       Size="Size.Small"
                       OnClick="JumpToCurrent"
                       Disabled="ViewModel.IsBusy || ViewModel.Competition.CurrentGame() is null"
                       title="Jump to the current round" />
      }
      <MudIconButton Icon="@Icons.Material.Filled.Help"
                     Size="Size.Small"
                     OnClick="@(() => { _showHelp = !_showHelp; })"
                     title="Keyboard shortcuts (H or ?)" />
      @if (ViewModel.IsBusy)
      {
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
      }
      @if (ViewModel.IsFinished && ViewModel.WinnerTeamId is { } winnerId)
      {
        var winnerTeam = DataService.AllTeams.FirstOrDefault(t => t.ShortName == winnerId);
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
          <MudChip T="string" Color="Color.Success" Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small">
            Winner: @(winnerTeam?.Name ?? winnerId)
          </MudChip>
          <FlagIcon Team="winnerTeam" Code="@winnerId" Size="28" />
        </MudStack>
      }
    </MudStack>

    @if (ViewModel.IsFinished)
    {
      @* Big circular Replay button — mirrors the Play FAB on /competitions and /competitions/setup
         so the click-through visually flows. Lands on the new (scheduled) competition's detail page. *@
      <MudStack AlignItems="AlignItems.Center" Class="my-2">
        <MudFab Color="Color.Primary"
                Size="Size.Large"
                StartIcon="@Icons.Material.Filled.Refresh"
                OnClick="HandleReplay"
                Disabled="ViewModel.IsBusy"
                title="Replay (clone this competition with the same teams)" />
      </MudStack>
    }

    @* Hierarchical timeline pickers: Stage chips on top, Round chips below.
       Status semantics: Selected → filled primary; Done → outlined success ✓; Current → outlined primary; Future → outlined default. *@
    <div class="timeline-pickers">
      <div class="timeline-row timeline-row-stage">
        <span class="timeline-label">Stage</span>
        <div class="timeline-chips">
          @foreach (var s in ViewModel.Stages)
          {
            var stageForChip = s;
            var isSelected = s.Id == ViewModel.SelectedStageId;
            var isCurrent  = s.Id == ViewModel.CurrentStageId;
            var isDone     = ViewModel.IsStageDone(s);
            <div class="timeline-cell">
              <MudChip T="string"
                       Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                       Color="@(isSelected ? Color.Primary : (isDone ? Color.Success : (isCurrent ? Color.Primary : Color.Default)))"
                       Size="Size.Medium"
                       Class="@ChipStatusClass(isSelected, isCurrent, isDone)"
                       Disabled="ViewModel.IsBusy"
                       OnClick="@(() => ViewModel.SelectedStageId = stageForChip.Id)">
                @s.Name@(isDone ? " ✓" : "")
              </MudChip>
            </div>
            @if (!isDone)
            {
              <div class="timeline-cell">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(async () => await ViewModel.SimulateStage(stageForChip.Id))"
                               Disabled="ViewModel.IsBusy"
                               title="@($"Simulate up through {s.Name}")" />
              </div>
            }
          }
        </div>
      </div>
      <div class="timeline-row timeline-row-round">
        <span class="timeline-label">Round</span>
        <div class="timeline-chips">
          @foreach (var r in ViewModel.Rounds)
          {
            var roundForChip = r;
            var isSelected = r.Id == ViewModel.SelectedRoundId;
            var isCurrent  = r.Id == ViewModel.CurrentRoundId;
            var isDone     = ViewModel.IsRoundDone(r);
            <div class="timeline-cell">
              <MudChip T="string"
                       Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                       Color="@(isSelected ? Color.Primary : (isDone ? Color.Success : (isCurrent ? Color.Primary : Color.Default)))"
                       Size="Size.Small"
                       Class="@ChipStatusClass(isSelected, isCurrent, isDone)"
                       Disabled="ViewModel.IsBusy"
                       OnClick="@(() => ViewModel.SelectedRoundId = roundForChip.Id)">
                @r.Name@(isDone ? " ✓" : "")
              </MudChip>
            </div>
            @if (!isDone)
            {
              <div class="timeline-cell">
                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(async () => await ViewModel.SimulateRound(roundForChip.Id))"
                               Disabled="ViewModel.IsBusy"
                               title="@($"Simulate up through {r.Name}")" />
              </div>
            }
          }
        </div>
      </div>
    </div>

    @* Games + Standings two-column layout *@
    <MudGrid Spacing="3">
      <MudItem xs="12" md="7">
        <MudPaper Class="pa-3 bounded-scroll-card" Elevation="4">
          <MudText Typo="Typo.h6" Class="mb-2">Games</MudText>
          @{
            var currentGame = ViewModel.Competition.CurrentGame();
            var lastFinishedGame = ViewModel.Competition.LastFinishedGame();
          }
          @if (ViewModel.SelectedStageId is { } selectedStageId)
          {
            @foreach (var round in ViewModel.Competition.Rounds.Where(r => r.StageId == selectedStageId).OrderBy(r => r.Order))
            {
              var games = ViewModel.Competition.RoundGames(round.Id).OrderBy(g => g.PlayedOn).ToList();
              var multiDay = games.Select(g => g.PlayedOn.Date).Distinct().Count() > 1;
              <section class="round-section @(round.Id == ViewModel.SelectedRoundId ? "round-section-selected" : "")">
                <div class="round-header">
                  <span class="round-header-name">@round.Name</span>
                </div>
                <div class="round-games-grid">
                  @foreach (var dayGroup in games.GroupBy(g => g.PlayedOn.Date))
                  {
                    @if (multiDay)
                    {
                      <div class="game-day-divider">@dayGroup.Key.ToString("ddd d MMM", System.Globalization.CultureInfo.CurrentCulture)</div>
                    }
                    @foreach (var game in dayGroup)
                    {
                      <FlatGameViewRow Game="game"
                                       Competition="ViewModel.Competition"
                                       ShowSim="@(ReferenceEquals(game, currentGame))"
                                       ShowUndo="@(ReferenceEquals(game, lastFinishedGame))"
                                       IsJustFinished="@(ViewModel.RecentlyFinishedGameId == game.Id)"
                                       Disabled="@ViewModel.IsBusy"
                                       OnSim="ViewModel.SimulateGame"
                                       OnUndo="ViewModel.UndoLastGame"
                                       OnRedo="ViewModel.RerollLastGame" />
                    }
                  }
                </div>
              </section>
            }
          }
        </MudPaper>
      </MudItem>
      <MudItem xs="12" md="5">
        <MudPaper Class="pa-3 bounded-scroll-card" Elevation="4">
          <MudText Typo="Typo.h6" GutterBottom="true">Standings</MudText>
          @* Standings: only group games have a per-round meaning. For KO rounds
             we fall back to showing all groups' final standings (computed in the VM). *@
          @if (ViewModel.GroupStandings.Count > 0)
          {
            @foreach (var (letter, standings) in ViewModel.GroupStandings)
            {
              <MudText Typo="Typo.subtitle2" Class="mt-2">Group @letter</MudText>
              <MudSimpleTable Dense="true" Hover="false">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>Team</th>
                    <th>P</th>
                    <th>W</th>
                    <th>D</th>
                    <th>L</th>
                    <th>GD</th>
                    <th>Pts</th>
                  </tr>
                </thead>
                <tbody>
                  @foreach (var row in standings)
                  {
                    var rowTeam = DataService.AllTeams.FirstOrDefault(t => t.ShortName == row.TeamId);
                    <tr>
                      <td>@row.Position</td>
                      <td>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                          <FlagIcon Team="rowTeam" Code="@row.TeamId" Size="20" />
                          <span>@(rowTeam?.Name ?? row.TeamId)</span>
                        </MudStack>
                      </td>
                      <td>@row.Played</td>
                      <td>@row.Wins</td>
                      <td>@row.Draws</td>
                      <td>@row.Losses</td>
                      <td>@row.GoalDifference</td>
                      <td><strong>@row.Points</strong></td>
                    </tr>
                  }
                </tbody>
              </MudSimpleTable>
            }
          }
          else
          {
            <MudText Typo="Typo.body2" Style="opacity:0.6;">
              (No groups in this competition format.)
            </MudText>
          }
        </MudPaper>
      </MudItem>
    </MudGrid>

  </MudStack>
}

<MudOverlay Visible="_showHelp" DarkBackground="true" ZIndex="9999" @onclick="@(() => { _showHelp = false; })">
  <MudPaper Class="pa-4" Elevation="8" @onclick:stopPropagation="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
      <MudIcon Icon="@Icons.Material.Filled.Keyboard" />
      <MudText Typo="Typo.h6">Keyboard shortcuts</MudText>
      <MudSpacer />
      <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => { _showHelp = false; })" />
    </MudStack>
    <KeyboardShortcuts />
  </MudPaper>
</MudOverlay>


@code {
  [Parameter] public int Id { get; set; }
  DotNetObjectReference<CompetitionDetail>? _selfRef;
  bool _showHelp;

  protected override async Task OnParametersSetAsync()
  {
    ViewModel.PropertyChanged += OnVmChanged;
    await ViewModel.LoadAsync(Id);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _selfRef = DotNetObjectReference.Create(this);
      await JS.InvokeVoidAsync("ffKeyboard.registerDocumentHandler", _selfRef);
    }
  }

  void OnVmChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    => InvokeAsync(StateHasChanged);

  async Task HandleReplay()
  {
    var newId = await ViewModel.ReplayAsync();
    if (newId is { } id) { Nav.NavigateTo($"competitions/{id}"); }
  }

  void JumpToCurrent()
  {
    if (ViewModel.Competition?.CurrentGame() is { } cg)
    {
      var round = ViewModel.Competition.Rounds.FirstOrDefault(r => r.Id == cg.RoundId);
      if (round is not null)
      {
        ViewModel.SelectedStageId = round.StageId;
        ViewModel.SelectedRoundId = round.Id;
      }
    }
  }

  /// <summary>
  /// Move the round selector by <paramref name="delta"/> within the current stage.
  /// Returns silently at the ends; doesn't wrap into the next stage (that's what ↑/↓ are for).
  /// </summary>
  void StepRound(int delta)
  {
    if (ViewModel.Competition is null || ViewModel.SelectedStageId is null) { return; }
    var rounds = ViewModel.Competition.Rounds.Where(r => r.StageId == ViewModel.SelectedStageId).OrderBy(r => r.Order).ToList();
    var idx = rounds.FindIndex(r => r.Id == ViewModel.SelectedRoundId);
    var next = idx + delta;
    if (next < 0 || next >= rounds.Count) { return; }
    ViewModel.SelectedRoundId = rounds[next].Id;
  }

  /// <summary>
  /// Move the stage selector by <paramref name="delta"/>.
  /// </summary>
  void StepStage(int delta)
  {
    if (ViewModel.Competition is null) { return; }
    var stages = ViewModel.Stages;
    var idx = stages.ToList().FindIndex(s => s.Id == ViewModel.SelectedStageId);
    var next = idx + delta;
    if (next < 0 || next >= stages.Count) { return; }
    ViewModel.SelectedStageId = stages[next].Id;
  }

  /// <summary>
  /// Document-level keyboard dispatch. Wired from js/keyboard.js — fires regardless of focus
  /// (but the JS layer skips input fields). Esc closes the help overlay if open, otherwise
  /// navigates back to /competitions. H/? toggle the overlay. Letters are case-insensitive.
  /// </summary>
  [JSInvokable]
  public async Task OnKeyDown(string key, bool ctrl, bool shift)
  {
    if (_showHelp && key == "Escape") { _showHelp = false; StateHasChanged(); return; }
    if (key == "Escape") { Nav.NavigateTo("competitions"); return; }
    if (key == "?" || key == "h" || key == "H") { _showHelp = !_showHelp; StateHasChanged(); return; }

    if (ctrl && (key == "z" || key == "Z" || key == "u" || key == "U")) { await ViewModel.UndoLastGame(); return; }
    if (ctrl && (key == "y" || key == "Y")) { await ViewModel.RerollLastGame(); return; }
    if (!ctrl && (key == "u" || key == "U")) { await ViewModel.UndoLastGame(); return; }

    if (key == " ") { if (shift) { await ViewModel.SimulateRound(); } else { await ViewModel.SimulateGame(); } return; }
    if (key == "r" || key == "R") { await ViewModel.SimulateRound(); return; }
    if (key == "t" || key == "T") { await ViewModel.SimulateAll(); return; }
    if (key == "ArrowLeft")  { StepRound(-1); return; }
    if (key == "ArrowRight") { StepRound(+1); return; }
    if (key == "ArrowUp")    { StepStage(-1); return; }
    if (key == "ArrowDown")  { StepStage(+1); return; }
  }

  // Selected → no status class (let the filled primary show through).
  // Done → chip-done.  Current → chip-current.  Future → chip-future.
  static string ChipStatusClass(bool isSelected, bool isCurrent, bool isDone)
  {
    if (isSelected) { return ""; }
    if (isDone) { return "chip-done"; }
    if (isCurrent) { return "chip-current"; }
    return "chip-future";
  }

  public async ValueTask DisposeAsync()
  {
    ViewModel.PropertyChanged -= OnVmChanged;
    if (_selfRef is not null)
    {
      try { await JS.InvokeVoidAsync("ffKeyboard.unregisterDocumentHandler"); }
      catch (JSDisconnectedException) { /* nav teardown: JS bridge already gone */ }
      _selfRef.Dispose();
      _selfRef = null;
    }
  }
}
