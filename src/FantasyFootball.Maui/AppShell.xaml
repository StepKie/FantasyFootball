<?xml version="1.0" encoding="UTF-8" ?>
<Shell
  x:Class="FantasyFootball.AppShell"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:views="clr-namespace:FantasyFootball.Views"
  xmlns:translate="clr-namespace:FantasyFootball.Markup">

  <!-- MAUI shell is Settings-only pending the BlazorWebView rewrite. Teams/Competitions
       UI lives in the Blazor host (FantasyFootball.Web). -->
  <TabBar>
    <ShellContent Title="{translate:Translate Settings}" ContentTemplate="{DataTemplate views:SettingsPage}" Icon="{x:StaticResource SettingsIcon}" />
  </TabBar>
</Shell>
